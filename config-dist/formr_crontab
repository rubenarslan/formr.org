# Run cron on run modules every x minutes
# Installation:
#   - copy file to ./config/formr_crontab
#   - activate the relevant command below
#   - Add to crontab preferably by using crontab 

# Expiration Cron Job at 02:08 o'clock
8 2 * * * php /var/www/formr/bin/cron_run_expiry.php 1>&2

# Cleanup orphaned files at 03:15 o'clock
15 3 * * * php /var/www/formr/bin/cron_cleanup_orphaned_files.php 1>&2

# Refresh the per-run metrics rollup (slow-query audit 2026-07 §6.2) that backs
# the compute-usage dashboards and admin run/user lists. Display-only, so a
# half-hourly cadence is plenty; the hourly compute-limit cron also refreshes
# it. Runs at :07/:37 — odd minutes, off the round marks where unit scheduling
# and the other crons cluster, so the aggregation scan doesn't contend.
7,37 * * * * php /var/www/formr/bin/cron_refresh_metrics.php 1>&2

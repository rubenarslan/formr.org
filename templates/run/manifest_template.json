{
  "name": "{APP_NAME}",
  "short_name": "{APP_NAME}",
  "description": "{DESCRIPTION}",
  "id": "{ID}",
  "start_url": "{START_URL}",
  "scope": "{SCOPE}",
  "display": "standalone",
  "background_color": "#e6ddcc",
  "theme_color": "#2196F3",
  "orientation": "any",
  "icons": [
    {
      "src": "{PWA_ICON_BASE_PATH}icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{PWA_ICON_BASE_PATH}icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "{PWA_ICON_BASE_PATH}screenshot_landscape.png",
      "sizes": "2622x1206", "type": "image/png", "form_factor": "wide", "label": "formr study (landscape)"
    },
    {
      "src": "{PWA_ICON_BASE_PATH}screenshot_portrait.png",
      "sizes": "1206x2622", "type": "image/png", "form_factor": "narrow", "label": "formr study (portrait)"
    }
  ],
  "display_override": ["window-controls-overlay", "standalone"],
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "shortcuts": [
    {
      "name": "Study", "url": "{START_URL}", "description": "Enter the study",
      "icons": [{ "src": "{PWA_ICON_BASE_PATH}icon.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "Settings", "url": "{START_URL}settings/", "description": "Change notification settings",
      "icons": [{ "src": "{PWA_ICON_BASE_PATH}message.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Privacy Policy", "url": "{START_URL}privacy/", "description": "Read our privacy policy",
      "icons": [{ "src": "{PWA_ICON_BASE_PATH}security.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Terms of Service", "url": "{START_URL}terms_of_service/", "description": "Read our terms of service",
      "icons": [{ "src": "{PWA_ICON_BASE_PATH}icon.png", "sizes": "512x512", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+formr{APP_PROTOCOL_SUFFIX}", "url": "{START_URL}?pwa=true&query=%s" }
  ]
} 
            "order": 50,
            "item_order": 50
        },
        {
            "type": "note",
            "name": "r_budget_note",
            "label": "### block\nSplit 100 between the two causes below. A `block` item keeps you on the page until the numbers add up.",
            "optional": 1,
            "order": 51,
            "item_order": 51
        },
        {
            "type": "number",
            "name": "r_needy",
            "label": "People in need",
            "optional": 0,
            "type_options": "0,100,1",
            "order": 52,
            "item_order": 52
        },
        {
            "type": "number",
            "name": "r_animals",
            "label": "Suffering animals",
            "optional": 0,
            "type_options": "0,100,1",
            "order": 53,
            "item_order": 53

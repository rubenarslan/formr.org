{
    "name": "all_widgets_v2",
    "settings": {},
    "items": [
        {
            "type": "note",
            "name": "intro",
            "label": "## All widgets (form_v2)\n\nEvery item type the **Form** engine supports, grouped by page. `showif`s are JavaScript and react as you type; `value`s are R, resolved when their page is shown. PWA items (install, push, cookie, phone hand-off) live in the separate `pwa_items_*` showcase.",
            "optional": 1,
            "order": 1,
            "item_order": 1
        },
        {
            "type": "get",
            "name": "code",
            "optional": 1,
            "type_options": "code",
            "order": 2,
            "item_order": 2
        },
        {
            "type": "text",
            "name": "t_text",
            "label": "### text\nWhere do you live?",
            "optional": 0,
            "order": 3,
            "item_order": 3
        },
        {
            "type": "textarea",
            "name": "t_textarea",
            "label": "### textarea\nAnd why would anybody want to live *there*?",
            "optional": 1,
            "showif": "answered(t_text)",
            "order": 4,
            "item_order": 4
        },
        {
            "type": "letters",
            "name": "t_letters",
            "label": "### letters\nLetters only.",
            "optional": 1,
            "order": 5,
            "item_order": 5
        },
        {
            "type": "text",
            "name": "t_pattern",
            "label": "### text with a pattern\nFive digits (the first choice is the message shown on a mismatch).",
            "optional": 1,
            "type_options": "[0-9]{5}",
            "choice_list": "t_pattern_msg",
            "choices": {
                "1": "Please enter five digits."
            },
            "order": 6,
            "item_order": 6
        },
        {
            "type": "email",
            "name": "t_email",
            "label": "### email\nYour e-mail address (not stored anywhere real).",
            "optional": 1,
            "order": 7,
            "item_order": 7
        },
        {
            "type": "url",
            "name": "t_url",
